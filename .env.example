# Optional. Without it HealthAuditor still runs all static rules; with it the report adds
# real Lighthouse Core Web Vitals (LCP, CLS, TBT, Speed Index) and field INP.
# Get one at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Optional WhatsApp enquiries number: international digits, no plus or spaces.
# When absent, contact buttons share HealthAuditor via WhatsApp instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Required for sign-in and server-side audit allowances. Run supabase/billing.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Use test credentials for testing, live credentials for production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A Razorpay plan with period=monthly, interval=1 and price $5 (500 USD cents).
# Example: create a $5/month plan in Razorpay Dashboard → Subscriptions → Plans.
# The price is read live from Razorpay and shown before checkout — do not hardcode it.
RAZORPAY_PLAN_ID=
# Positive integer: audits allowed in each paid billing cycle. E.g. 100 for Pro.
# Checkout remains disabled until this is set to a positive integer.
AUDITS_PER_MONTH=
