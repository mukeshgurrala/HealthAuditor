# Optional. Without it HealthAuditor still runs all static rules; with it the report adds
# real Lighthouse Core Web Vitals (LCP, CLS, TBT, Speed Index) and field INP.
# Get one at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Optional WhatsApp enquiries number: international digits, no plus or spaces.
# When absent, contact buttons share HealthAuditor via WhatsApp instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=
